# --- Discord ---
TOKEN=
APP_ID=
# Serveur de dev : slash commands synchronisées au démarrage (évite d'oublier &sync)
DEV_GUILD=

# --- Mode Radio / Lavalink ---
# Hôte et port du serveur Lavalink v4 (voir lavalink/README.md)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# --- Spotify (métadonnées uniquement, via Spotipy) ---
# https://developer.spotify.com/dashboard -> créer une app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optionnel : restreint la radio à un seul serveur Discord.
# Les salons vocal/texte se configurent en jeu via /radioconfig.
RADIO_GUILD_ID=
